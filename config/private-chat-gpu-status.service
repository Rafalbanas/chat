[Unit]
Description=Read-only CV Tailor activity indicator for private chat
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/private-chat/ops/gpu_status.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=private-chat
RuntimeDirectoryMode=0755
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/run/private-chat
MemoryMax=64M
CPUQuota=5%
UMask=0022

[Install]
WantedBy=multi-user.target
